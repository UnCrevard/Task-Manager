    // Infobulles / Tooltips d'historique 1h
    IDS_TIP_TIME_MIN_SEC        "-%dm %02ds • %.1f %%"
    IDS_TIP_TIME_SEC            "-%ds • %.1f %%"
    IDS_TIP_TOP_PROC            "Top : %.18s (%u)"
    IDS_TIP_USAGE_PCT           "Utilisation : %.1f %%"
    IDS_TIP_USAGE_RAM           "Mémoire : %u Mo"
    IDS_TIP_NO_DATA             "Aucune activité"

    // Classes de priorité (affichage de liste)
    IDS_PRIO_REALTIME           "Temps réel"
    IDS_PRIO_HIGH               "Haute"
    IDS_PRIO_ABOVENORM          "Supérieure"
    IDS_PRIO_NORMAL             "Normale"
    IDS_PRIO_BELOWNORM          "Inférieure"
    IDS_PRIO_IDLE               "Basse"
    IDS_PRIO_UNKNOWN            "Inconnue"

    // CLI restreinte & unités
    IDS_STR_RESTRICTED          "[Système / Accès restreint]"
    IDS_STR_RESTRICTED_ACCESS   "[Accès restreint]"
    IDS_STR_NO_NTAPI            "[Non disponible - NTAPI absente]"
    IDS_UNIT_RAM_FMT            "%u Mo"
    IDS_UNIT_DISK_FMT           "%.2f Mo/s"
    IDS_UNIT_NET_FMT            "%.1f Ko/s"

    // Fenêtre Paramètres
    IDS_SETTINGS_TITLE          "Paramètres"
    IDS_SETTINGS_LANG_LABEL     "Langue de l'interface :"
    IDS_SETTINGS_LANG_AUTO      "Système (Auto - Anglais par défaut)"
    IDS_SETTINGS_LANG_EN        "English"
    IDS_SETTINGS_LANG_FR        "Français"
    IDS_SETTINGS_AUTOREFRESH    "Rafraîchissement automatique (1 seconde)"
