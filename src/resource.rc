    IDS_TRAY_RAM_FMT            "Historique RAM : %.1f %% (%.1f / %.1f Go)"
    IDS_TRAY_GPU_FMT            "Historique GPU : %.1f %%"
    IDS_TRAY_TIP_RAM_FMT        "RAM : %.1f %% (%.1f/%.1fGo)\n1. %.10s: %uMo\n2. %.10s: %uMo\n3. %.10s: %uMo\n4. %.10s: %uMo"

    // Barre d'état (Status Bar)
    IDS_STATUS_PROCESSES_FMT    "Processus : %d / %d"
    IDS_STATUS_CPU_FMT          "CPU Global : %.1f %%"
    IDS_STATUS_RAM_FMT          "RAM : %u / %u Mo (%u %%)"
    IDS_STATUS_EXCLUSIONS_FMT   "Exclusions : %d actives | Tri : %s %s"

    // Graphiques de performances 1 heure
    IDS_GRAPH_CPU_TITLE         "CPU"
    IDS_GRAPH_CPU_SUB           "1 heure • % d'utilisation"
    IDS_GRAPH_RAM_TITLE         "Mémoire"
