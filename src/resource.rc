    IDS_ABOUT_APP_NAME          "Gestionnaire des tâches Windows"
    IDS_ABOUT_VERSION_FMT       "Version %s (Build %d)"
    IDS_ABOUT_COMPILE_FMT       "Compilé le %s à %s"
    IDS_ABOUT_TECH              "Win32 API / NTAPI natif en C pur (MinGW-w64)"
    IDS_ABOUT_DESC              "Moniteur de processus temps réel sans scintillement avec historique 1h, icônes dynamiques dans la barre des tâches, mode sombre adaptatif et gestion des exclusions."
    IDS_BTN_CLOSE               "Fermer"
END

