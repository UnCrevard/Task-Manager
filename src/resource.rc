#pragma code_page(65001)

// Resource file pour le Gestionnaire des tâches Win32 natif (Multilingue FR / EN)
#include "resource.h"
#include "version.h"

// 1ère icône du binaire PE = icône par défaut de l'exécutable sous l'explorateur Windows
IDI_APP_ICON ICON "app.ico"

// Manifeste Windows moderne pour activer les Styles Visuels (Common Controls v6)
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "taskmgr.manifest"

// Informations de version intégrées au binaire PE (Propriétés Windows -> Détails)
1 VERSIONINFO
FILEVERSION     APP_VER_MAJOR, APP_VER_MINOR, APP_VER_PATCH, APP_VER_BUILD
PRODUCTVERSION  APP_VER_MAJOR, APP_VER_MINOR, APP_VER_PATCH, APP_VER_BUILD
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription",  "Windows Native Task Manager (C Win32)"
            VALUE "FileVersion",      APP_VERSION_FULL_A
            VALUE "InternalName",     "taskmgr.exe"
            VALUE "OriginalFilename", "taskmgr.exe"
            VALUE "ProductName",      "Win32 Native Task Manager"
            VALUE "ProductVersion",   APP_VERSION_FULL_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END

// ============================================================================
// Table des chaînes de caractères — FRANÇAIS (ID base 5000)
// ============================================================================
STRINGTABLE
BEGIN
    IDS_APP_TITLE               "Gestionnaire des tâches Windows (C Win32 Natif)"

    // Colonnes de la ListView
    IDS_COL_NAME                "Nom de l'image"
    IDS_COL_PID                 "PID"
    IDS_COL_CPU                 "CPU %"
    IDS_COL_RAM                 "Mémoire (Mo)"
    IDS_COL_DISK                "Disque (Mo/s)"
    IDS_COL_NET                 "Réseau (Ko/s)"
    IDS_COL_GPU                 "GPU %"
    IDS_COL_PRIORITY            "Priorité"
    IDS_COL_CMDLINE             "Ligne de commande (CLI Args)"

    // Boutons de la barre d'outils
    IDS_BTN_AUTOREFRESH_ON      "Auto-refresh Oui"
    IDS_BTN_AUTOREFRESH_OFF     "Auto-refresh Non"
    IDS_BTN_REFRESH             "Actualiser (F5)"
    IDS_BTN_WINDOWS_ON          "Windows Oui"
    IDS_BTN_WINDOWS_OFF         "Windows Non"
    IDS_BTN_EXCLUSIONS_FMT      "Exclusions (%d)"
    IDS_LABEL_FILTER            "Filtrer :"
    IDS_BTN_SETTINGS            "Paramètres"
